# This config enables only capabilities that have had their exact Azure service,
# model, region, terms, and retention configuration reviewed for clinic PHI.
JMCGPT_TENANT_ID=0b565777-2294-4ad4-983d-985158812485
JMCGPT_STAFF_DOMAIN=jaymedical.com
JMCGPT_DATA_MODE=phi
JMCGPT_WEB_ENABLED=false
JMCGPT_PUBLIC_ORIGIN=https://jmcgpt.jaymedical.com
AZURE_CLIENT_ID=fa2e4673-dc95-47df-a7f2-83e83b8416e5
AZURE_OPENAI_ENDPOINT=https://jaymedai.openai.azure.com
AZURE_OPENAI_RESOURCE_ID=/subscriptions/188f6026-c52a-4ced-b7d8-2ad1f6eb6070/resourceGroups/JayMedical/providers/Microsoft.CognitiveServices/accounts/jaymedai
AZURE_OPENAI_CHAT_DEPLOYMENT=jmcgpt-astra
AZURE_OPENAI_VISION_DEPLOYMENT=jmcgpt-astra
AZURE_OPENAI_IMAGE_DEPLOYMENT=REPLACE
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=REPLACE
# Deliberately blank: startup fails until service review is recorded by operator.
# Startup also checks the live resource for ContentLogging=false; missing/unknown
# status blocks startup. The managed identity needs read access to that resource.
JMCGPT_APPROVED_CAPABILITIES=
AZURE_OPENAI_API_VERSION=2024-10-21
# Exact image API/version eligibility must be checked; do not assume preview coverage.
AZURE_OPENAI_IMAGE_API_VERSION=
ENABLE_AZURE_MONITOR_TRACING=False
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=False
